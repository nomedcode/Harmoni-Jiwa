# Frontend environment template — copy to app/.env.local
# Supabase values come from `supabase status` after `supabase start`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-local-key-from-supabase-status

# Browser-facing Laravel API. Optional in development (defaults to
# http://127.0.0.1:8000/api/v1); required in production builds.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Canonical URL used by metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
