# Backend environment template for docker compose.
# Postgres runs as a compose service (defaults match docker-compose.yml) and
# the local Supabase auth stack keeps running on the host via the CLI.

APP_NAME=HarmoniJiwa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

# Hostnames match the compose service names.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=klinik_personal
DB_USERNAME=postgres
DB_PASSWORD=postgres

# The Supabase CLI stack runs on the host, not inside compose. Two different
# URLs are needed inside a container:
#   - SUPABASE_URL must stay the host form (http://127.0.0.1:54321) because
#     the issuer check compares it with the "iss" claim of tokens minted on
#     the host (http://127.0.0.1:54321/auth/v1).
#   - SUPABASE_JWKS_URL must be network-reachable from the container, so it
#     goes through host.docker.internal (127.0.0.1 inside a container is the
#     container itself).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWKS_URL=http://host.docker.internal:54321/auth/v1/.well-known/jwks.json
# Legacy HS256 secret; ES256 projects use the published JWKS above.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM=HS256
# HS256 is a shared secret: off by default. Turn on only if your Supabase
# project still signs with HS256 instead of ES256/JWKS.
SUPABASE_JWT_LEGACY_HS256_ENABLED=false
# Optional override; otherwise derived as <SUPABASE_URL>/auth/v1.
# Tokens whose "iss" does not match are rejected with 401.
SUPABASE_JWT_ISSUER=
# Comma separated list of accepted "aud" claims.
SUPABASE_JWT_AUDIENCES=authenticated

FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000

# API rate limits. General is per minute per IP; appointment writes are per
# hour per authenticated user. Set to 0 to disable the booking limit.
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_APPOINTMENTS_PER_HOUR=10

# API is stateless. Use array session storage unless web session features are added.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
