# Values consumed by docker-compose.yml — docker compose auto-loads .env
# from this directory. Copy to .env and fill in the machine-specific key.

# Required: publishable key of the LOCAL Supabase stack (`supabase status`).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional overrides — defaults live in docker-compose.yml.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8080/api/v1
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_JWKS_URL=http://host.docker.internal:54321/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=
# FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres        # local demo credentials only
# POSTGRES_DB=klinik_personal
# APP_KEY=                          # compose embeds a demo-only fallback
